# Copy this file to backend/.env and fill in real values.
# backend/.env is already git-ignored - never commit real secrets.

# Existing - required for map/satellite imagery lookups
GOOGLE_MAPS_API_KEY=

# New - used to sign session cookies for login. Use a long random string in production,
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# New - the origin your React dev server runs on, used for CORS + cookies
FRONTEND_ORIGIN=http://localhost:5173

# New - optional. Defaults to a local SQLite file at backend/database.db
# DATABASE_URL=sqlite:///database.db

# New - set to "true" only when serving over HTTPS in production
SESSION_COOKIE_SECURE=false
